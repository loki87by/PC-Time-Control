{
  "name": "pc-time-control",
  "version": "1.1.1",
  "type": "module",
  "description": "PC time control with remote management",
  "main": "index.js",
  "imports": {
    "#config": "./src/setup/config.js",
    "#web/*": "./src/web/*.js",
    "#utils/*": "./src/utils/*.js",
    "#consts": "./src/constants/consts.js"
  },
  "scripts": {
    "start": "node index.js",
    "install-service": "node src/setup/installer.js",
    "uninstall-service": "node src/setup/installer.js uninstall",
    "install-service-linux": "sudo node src/setup/installer-linux.js",
    "uninstall-service-linux": "sudo node src/setup/installer-linux.js uninstall",
    "service-status-linux": "node src/setup/installer-linux.js status",
    "update-children": "node scripts/update-agent.js --scan"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "winston": "^3.11.0"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@qiudaomao/node-frp": "^1.1.5"
  }
}
